          ]}}],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/jobs/{{openemrJobId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","jobs","{{openemrJobId}}"] } }
        },
        {
          "name": "A4 · OpenEMR (mock) — verifikasi Patient mendarat",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Patient ditemukan di OpenEMR', () => pm.expect(b.total).to.be.at.least(1));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{openemrUrl}}/Patient?identifier={{patientMrn}}", "host": ["{{openemrUrl}}"], "path": ["Patient"], "query": [{ "key": "identifier", "value": "{{patientMrn}}" }] } }
        }
