        {
          "name": "Me — peran token saat ini",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('ada role', () => pm.expect(pm.response.json().role).to.be.a('string'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","me"] } }
        },
        {
          "name": "Roles — peran terkonfigurasi",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/roles", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","roles"] } }
        }
      ]
    },
    {
      "name": "01 · A — Patient OpenMRS → OpenEMR (adapter)",
      "description": "Alur A: tarik Patient dari OpenMRS (mock) lalu teruskan lewat adapter middleware ke OpenEMR. Menunjukkan peran adapter.",
      "item": [
        {
          "name": "A1 · OpenMRS (mock) — tarik Patient MRN-001",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('Bundle', () => pm.expect(pm.response.json().resourceType).to.eql('Bundle'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{openmrsUrl}}/Patient?identifier={{patientMrn}}", "host": ["{{openmrsUrl}}"], "path": ["Patient"], "query": [{ "key": "identifier", "value": "{{patientMrn}}" }] } }
        },
        {
          "name": "A2 · Middleware — enqueue Patient → OpenEMR",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('ok', () => pm.expect(j.ok).to.eql(true));",
            "pm.test('ada job_id', () => pm.expect(j.job_id).to.be.a('string'));",
            "pm.collectionVariables.set('openemrJobId', j.job_id);",
            "pm.collectionVariables.set('lastJobId', j.job_id);"
          ]}}],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"source_system\": \"openmrs\",\n  \"target_system\": \"openemr\",\n  \"resource\": {\n    \"resourceType\": \"Patient\",\n    \"identifier\": [{\"system\": \"http://openmrs.org/mrn\", \"value\": \"{{patientMrn}}\"}],\n    \"name\": [{\"family\": \"Santoso\", \"given\": [\"Budi\"]}],\n    \"gender\": \"male\",\n    \"birthDate\": \"1985-04-12\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/jobs/enqueue", "host": ["{{baseUrl}}"], "path": ["api","v1","jobs","enqueue"] }
          }
        },
        {
          "name": "A3 · Middleware — detail job (poll status)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
