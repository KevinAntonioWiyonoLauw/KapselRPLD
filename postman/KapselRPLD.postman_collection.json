    {
      "name": "04 · D — RBAC (kontrol akses per peran)",
      "description": "Buktikan RBAC: viewer hanya baca; aksi tulis dengan viewer = 403; operator/admin boleh.",
      "item": [
        {
          "name": "D1 · viewer boleh GET /jobs",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200 (viewer read)', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{viewerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/jobs?limit=1", "host": ["{{baseUrl}}"], "path": ["api","v1","jobs"], "query": [{ "key": "limit", "value": "1" }] }
