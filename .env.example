# =====================================================================
# Middleware Interoperabilitas HL7 FHIR - contoh konfigurasi
# SALIN menjadi .env lalu sesuaikan. JANGAN commit file .env.
# =====================================================================

# --- Database ---
POSTGRES_DB=middleware
POSTGRES_USER=middleware
POSTGRES_PASSWORD=change_me_db
DATABASE_URL=postgresql+psycopg2://middleware:change_me_db@db:5432/middleware

# --- Backend ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Token admin untuk Management API (ganti!)
ADMIN_API_TOKEN=change_me_admin_token
# Token operator (opsional, RBAC): retry/resolve/check/mapping; kosong = hanya admin
OPERATOR_API_TOKEN=
# CORS allowlist (comma-separated). Jangan "*" di production.
CORS_ORIGINS=http://localhost:3000
# Aktifkan HAPI validator (opsional). Jika false, pakai light validator.
USE_HAPI_VALIDATOR=false
HAPI_VALIDATOR_URL=http://hapi-validator:3500

# --- OpenMRS Adapter ---
OPENMRS_ENABLED=true
OPENMRS_MODE=mock                 # mock | real
OPENMRS_FHIR_BASE_URL=http://openmrs:8080/openmrs/ws/fhir2/R4
OPENMRS_AUTH_TYPE=basic           # basic | none
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123
OPENMRS_MOCK_URL=http://mock-ehr:8100/openmrs
# FHIR2 create rules (non-secret reference data / verified defaults)
OPENMRS_IDENTIFIER_SYSTEM=http://openmrs.org/mrn
OPENMRS_IDENTIFIER_TYPE_NAME=Old Identification Number
OPENMRS_DEFAULT_LOCATION_UUID=8d6c993e-c2cc-11de-8d13-0010c6dffd0f
OPENMRS_ENCOUNTER_TYPE_UUID=d7151f82-c1f3-4152-a605-2f9ea7414a79
OPENMRS_ENCOUNTER_TYPE_NAME=Visit Note

# --- OpenEMR Adapter ---
OPENEMR_ENABLED=true
OPENEMR_MODE=mock                 # mock | real
OPENEMR_FHIR_BASE_URL=http://openemr/apis/default/fhir
OPENEMR_AUTH_TYPE=oauth2_client_credentials
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
OPENEMR_TOKEN_URL=http://openemr/oauth2/default/token
# OpenEMR lokal/nyata: isi username/password untuk memakai password grant
# (aktifkan global oauth_password_grant; lihat docs/openemr-real-integration.md)
OPENEMR_USERNAME=
OPENEMR_PASSWORD=
OPENEMR_MOCK_URL=http://mock-ehr:8100/openemr

# --- SATUSEHAT Adapter ---
SATUSEHAT_ENABLED=true
SATUSEHAT_MODE=mock               # mock | sandbox | production
SATUSEHAT_FHIR_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_TOKEN_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1/accesstoken?grant_type=client_credentials
# Organization IHS id (dari SSP / Kode Akses API Sandbox)
# Dipakai backend untuk outbound, dan dashboard (SSRME CHLink demo) via NEXT_PUBLIC_SATUSEHAT_ORG_ID.
SATUSEHAT_ORG_ID=
# Default prasyarat untuk jalur otomatis ke SATUSEHAT
SATUSEHAT_PRACTITIONER_IHS=10009880010
SATUSEHAT_LOCATION_ID=
SATUSEHAT_DEFAULT_ICD10=J06.9
SATUSEHAT_DEFAULT_ICD10_DISPLAY=Acute upper respiratory infection, unspecified
# SSRME (viewing) — Juknis SSRME V2.0
SSRME_ENABLED=true
SSRME_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/ssrme/v2/ntl
SATUSEHAT_MOCK_URL=http://mock-satusehat:8200/fhir-r4/v1

# --- Scheduler ---
POLL_INTERVAL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=120

# --- Worker ---
WORKER_POLL_SECONDS=5
RETRY_MAX_ATTEMPTS=5

# --- Hardening ---
# Bersihkan payload tersimpan setelah sukses (privasi data klinis)
PAYLOAD_RETENTION_ON_SUCCESS=true
# Batasi request Management API per menit per IP (0 = nonaktif)
RATE_LIMIT_PER_MINUTE=120

# --- Keamanan (#17) ---
# Paksa redirect HTTP->HTTPS (set true di produksi, di belakang proxy TLS)
FORCE_HTTPS=false
# HSTS max-age (detik). Hanya dikirim saat koneksi HTTPS.
HSTS_MAX_AGE=31536000
# Allowlist Host header (dipisah koma). Kosong = terima semua (dev).
ALLOWED_HOSTS=

# --- Observability (#16) ---
# Format log: text | json (json = structured, machine-parseable)
LOG_FORMAT=text
# Expose /metrics/prometheus (scrape target)
METRICS_ENABLED=true
